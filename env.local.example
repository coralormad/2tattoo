# ---- Supabase (cliente, público, expuestas al navegador) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Supabase (solo servidor, salta RLS) ----
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (Calendar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Meta / Instagram OAuth (Instagram API with Instagram Login) ----
META_APP_ID=
META_APP_SECRET=
# Opcional: solo si el redirect_uri no se puede derivar del origin (p.ej. detrás de un proxy en producción)
INSTAGRAM_REDIRECT_URI=
