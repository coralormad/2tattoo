# Copia este archivo como .env.local y rellena con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Service role key: Supabase → Project Settings → API → "service_role" secret.
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador:
# solo se usa en servidor para leer el token de Google de OTRO tatuador
# al calcular sus huecos libres (ver src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=


GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Instagram (Meta, inicio de sesion unificado): App ID / App Secret de App settings -> Basic
# META_CONFIG_ID: configuracion de Facebook Login for Business (genera la URL con config_id)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Debe coincidir con la URL de redireccion configurada en la app de Meta
INSTAGRAM_REDIRECT_URI=https://2tattoo.vercel.app/auth/instagram/callback
